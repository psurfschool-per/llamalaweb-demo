---
import Base from "./Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import type { BlogPost } from "../data/blog";

type Props = {
  post: BlogPost;
};

const { post } = Astro.props;
const postUrl = new URL(`/blog/${post.slug}/`, site.url).href;

const blogPostingLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.description,
  inLanguage: "es",
  datePublished: post.date,
  dateModified: post.date,
  url: postUrl,
  mainEntityOfPage: postUrl,
  image: `${site.url}/images/og.png`,
  keywords: post.tags.join(", "),
  author: { "@type": "Organization", name: "llamalaweb", url: site.url },
  publisher: {
    "@type": "Organization",
    name: "llamalaweb",
    logo: { "@type": "ImageObject", url: `${site.url}/images/logo.png` },
  },
};
---

<Base title={`${post.title} | Blog llamalaweb`} description={post.description}>
  <Nav />
  <main id="contenido">
    <article class="container-x py-16 sm:py-20">
      <a
        href="/blog"
        class="inline-flex items-center gap-1.5 font-display text-sm font-bold text-grape hover:underline"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-4 w-4">
          <path d="M19 12H5M11 18l-6-6 6-6" />
        </svg>
        Volver al blog
      </a>

      <header class="reveal mt-8 max-w-3xl">
        <div class="flex flex-wrap items-center gap-2">
          <span class="eyebrow">Blog</span>
          {post.tags.map((tag) => (
            <span class:list={["rounded-full border-2 border-ink px-3 py-1 font-display text-xs font-bold uppercase tracking-wide", post.tile]}>
              {tag}
            </span>
          ))}
        </div>
        <h1 class="section-title mt-5">{post.title}</h1>
        <p class="mt-4 text-lg leading-relaxed text-ink/65">{post.description}</p>
        <p class="mt-4 text-xs font-semibold uppercase tracking-[0.14em] text-ink/45">
          {post.dateLabel} · {post.minutes} min de lectura · Por el equipo de llamalaweb
        </p>
      </header>

      <div class="legal-body reveal mt-10 max-w-3xl">
        <slot />
      </div>
    </article>
  </main>
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingLd)} />
</Base>
