---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { blogPosts } from "../../data/blog";
import { site } from "../../data/site";

const blogLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Blog de llamalaweb",
  url: `${site.url}/blog/`,
  description:
    "Guías prácticas de diseño web, precios, SEO y ventas online para negocios de habla hispana.",
  inLanguage: "es",
  publisher: { "@type": "Organization", name: "llamalaweb", url: site.url },
  blogPost: blogPosts.map((post) => ({
    "@type": "BlogPosting",
    headline: post.title,
    description: post.description,
    datePublished: post.date,
    url: `${site.url}/blog/${post.slug}/`,
  })),
};
---

<Base
  title="Blog de diseño web y ventas online | llamalaweb"
  description="Guías prácticas y sin tecnicismos: cuánto cuesta una web en Perú, qué necesita tu negocio para vender online y cómo aprovechar WhatsApp como canal de ventas."
>
  <Nav />
  <main id="contenido">
    <div class="container-x py-16 sm:py-20">
      <div class="reveal max-w-2xl">
        <span class="eyebrow">Blog</span>
        <h1 class="section-title mt-5">
          Ideas claras para <span class="text-grape">crecer online</span>.
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-ink/65">
          Escribimos lo que le contamos a nuestros clientes: precios reales, checklists y tácticas
          para que tu web trabaje por tu negocio.
        </p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {
          blogPosts.map((post, index) => (
            <a
              href={`/blog/${post.slug}/`}
              class="reveal group flex flex-col rounded-[1.75rem] border-2 border-ink bg-white p-6 shadow-pop-sm transition duration-200 hover:-translate-y-1 hover:shadow-pop"
              style={`transition-delay: ${index * 70}ms`}
            >
              <div class="flex flex-wrap items-center gap-2">
                <span class:list={["rounded-full border-2 border-ink px-2.5 py-0.5 font-display text-[0.65rem] font-bold uppercase tracking-wide", post.tile]}>
                  {post.tags[0]}
                </span>
                <span class="text-xs font-semibold text-ink/70">{post.minutes} min</span>
              </div>
              <h2 class="mt-4 font-display text-xl font-extrabold leading-snug tracking-tight group-hover:underline">
                {post.title}
              </h2>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-ink/65">{post.description}</p>
              <p class="mt-5 text-xs font-semibold uppercase tracking-[0.14em] text-ink/70">{post.dateLabel}</p>
            </a>
          ))
        }
      </div>

      <p class="reveal mt-12 text-center text-sm font-medium text-ink/70">
        ¿Tienes un proyecto en mente?
        <a href="/#contacto" class="link-underline font-bold text-ink">Conversemos</a>
      </p>
    </div>
  </main>
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(blogLd)} />
</Base>
