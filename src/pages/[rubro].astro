---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import Check from "../components/Check.astro";
import WhatsAppIcon from "../components/WhatsAppIcon.astro";
import { niches, type Niche } from "../data/niches";
import { portfolio, site, waLink } from "../data/site";

export function getStaticPaths() {
  return niches.map((niche) => ({ params: { rubro: niche.slug }, props: { niche } }));
}

type Props = { niche: Niche };
const { niche } = Astro.props;

const projects = portfolio.filter((project) => niche.projects.includes(project.slug));
const pageUrl = new URL(`/${niche.slug}/`, site.url).href;
const waMessage = `¡Hola llamalaweb! Tengo un negocio de ${niche.label.toLowerCase()} y quiero una web. ¿Podemos conversar?`;

const serviceLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: niche.serviceType,
  serviceType: niche.serviceType,
  description: niche.description,
  url: pageUrl,
  areaServed: { "@type": "Country", name: "Perú" },
  provider: { "@type": "ProfessionalService", name: "llamalaweb", url: site.url },
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: niche.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: { "@type": "Answer", text: faq.a },
  })),
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: site.url },
    { "@type": "ListItem", position: 2, name: niche.label, item: pageUrl },
  ],
};
---

<Base title={niche.title} description={niche.description}>
  <Nav />
  <main id="contenido">
    {/* Hero */}
    <section class="relative overflow-hidden border-b-2 border-ink bg-grape-soft/60 py-16 sm:py-20">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0">
        <div class="absolute -right-24 -top-16 h-72 w-72 rounded-full bg-sky/30 blur-3xl"></div>
        <div class="absolute -left-20 bottom-0 h-64 w-64 rounded-full bg-pink/25 blur-3xl"></div>
      </div>
      <div class="container-x relative">
        <div class="reveal max-w-3xl">
          <span class="eyebrow">{niche.label}</span>
          <h1 class="section-title mt-5">{niche.h1}</h1>
          <p class="mt-5 text-lg leading-relaxed text-ink/70">{niche.intro}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/#contacto" class="btn btn-primary">Quiero mi web</a>
            <a href="/#planes" class="btn btn-secondary">Ver planes y precios</a>
          </div>
          <p class="mt-4 text-sm font-medium text-ink/60">
            Entrega desde 5–7 días · Sin permanencia · Hosting desde $20/mes
          </p>
        </div>
      </div>
    </section>

    {/* Qué incluye */}
    <section class="py-16 sm:py-20">
      <div class="container-x">
        <div class="reveal max-w-2xl">
          <span class="eyebrow">Qué incluye</span>
          <h2 class="section-title mt-5">
            Todo lo que tu web de <span class="text-grape">{niche.label.toLowerCase()}</span> necesita.
          </h2>
        </div>
        <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {
            niche.includes.map((item, index) => (
              <article
                class="reveal rounded-[1.5rem] border-2 border-ink bg-white p-6 shadow-pop-sm transition duration-200 hover:-translate-y-1 hover:shadow-pop"
                style={`transition-delay: ${index * 60}ms`}
              >
                <div class:list={["flex h-12 w-12 items-center justify-center rounded-xl border-2 border-ink", niche.tile]}>
                  <Icon name={item.icon} class="h-6 w-6" />
                </div>
                <h3 class="mt-4 font-display text-lg font-extrabold tracking-tight">{item.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink/65">{item.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    {/* Beneficios */}
    <section class="border-y-2 border-ink bg-ink py-16 text-cream sm:py-20">
      <div class="container-x grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:items-center">
        <div class="reveal">
          <span class="eyebrow border-cream/20 bg-cream/10 text-cream">Resultados</span>
          <h2 class="section-title mt-5">Cómo se traduce en ventas para tu negocio.</h2>
          <a href={waLink(waMessage)} target="_blank" rel="noopener noreferrer" class="btn mt-7 border-cream/30 bg-cream text-ink hover:bg-sky">
            <WhatsAppIcon class="h-4 w-4" />
            Conversar por WhatsApp
          </a>
        </div>
        <ul class="reveal flex flex-col gap-4">
          {
            niche.benefits.map((benefit) => (
              <li class="flex items-start gap-3 rounded-2xl border-2 border-cream/15 bg-cream/5 p-4 text-sm leading-relaxed text-cream/85 sm:text-base">
                <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-sky text-ink">
                  <Check class="h-3.5 w-3.5" />
                </span>
                {benefit}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* Prueba social */}
    {
      projects.length > 0 ? (
        <section class="py-16 sm:py-20">
          <div class="container-x">
            <div class="reveal max-w-2xl">
              <span class="eyebrow">Casos reales</span>
              <h2 class="section-title mt-5">Negocios como el tuyo que ya están online.</h2>
            </div>
            <div class="mx-auto mt-10 grid w-full max-w-3xl gap-6 sm:grid-cols-2">
              {projects.map((project) => (
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="reveal group overflow-hidden rounded-[1.5rem] border-2 border-ink bg-white shadow-pop-sm transition duration-200 hover:-translate-y-1 hover:shadow-pop"
                >
                  <span class="block aspect-[2/1] overflow-hidden">
                    <img
                      src={project.image}
                      alt={`Captura del sitio web de ${project.name}`}
                      width="1600"
                      height="800"
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover object-center transition-transform duration-300 group-hover:scale-[1.03]"
                    />
                  </span>
                  <span class="flex items-center justify-between gap-3 p-5">
                    <span>
                      <span class="block font-display text-lg font-extrabold tracking-tight">{project.name}</span>
                      <span class="block text-xs font-semibold uppercase tracking-wide text-ink/50">{project.category}</span>
                    </span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-4 w-4 shrink-0 text-grape transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5">
                      <path d="M7 17 17 7M9 7h8v8" />
                    </svg>
                  </span>
                </a>
              ))}
            </div>
          </div>
        </section>
      ) : (
        <section class="py-16 sm:py-20">
          <div class="container-x">
            <div class="reveal mx-auto max-w-2xl rounded-[1.75rem] border-2 border-ink bg-white p-8 text-center shadow-pop-sm">
              <h2 class="font-display text-2xl font-extrabold tracking-tight">Ya hemos lanzado webs que reciben clientes cada día.</h2>
              <p class="mt-3 leading-relaxed text-ink/65">
                Tiendas, escuelas e inmobiliarias confían su presencia online a llamalaweb. Mira cómo
                trabajan sus sitios y imagina el tuyo.
              </p>
              <a href="/#portafolio" class="btn btn-secondary mt-6">Ver portafolio completo</a>
            </div>
          </div>
        </section>
      )
    }

    {/* FAQ del rubro */}
    <section class="border-t-2 border-ink bg-grape-soft/60 py-16 sm:py-20">
      <div class="container-x">
        <div class="reveal mx-auto max-w-2xl text-center">
          <span class="eyebrow">Preguntas del rubro</span>
          <h2 class="section-title mt-5">Lo que nos preguntan antes de empezar.</h2>
        </div>
        <div class="mx-auto mt-10 flex max-w-3xl flex-col gap-4">
          {
            niche.faqs.map((faq) => (
              <details class="reveal group rounded-2xl border-2 border-ink bg-white shadow-pop-sm">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-display font-bold [&::-webkit-details-marker]:hidden">
                  {faq.q}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true" class="h-4 w-4 shrink-0 text-grape transition-transform group-open:rotate-45">
                    <path d="M12 5v14M5 12h14" />
                  </svg>
                </summary>
                <p class="px-5 pb-5 text-sm leading-relaxed text-ink/70">{faq.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    {/* CTA final */}
    <section class="border-t-2 border-ink bg-grape py-16 text-white sm:py-20">
      <div class="container-x reveal mx-auto max-w-2xl text-center">
        <h2 class="section-title">Tu web de {niche.label.toLowerCase()}, lista para recibir clientes.</h2>
        <p class="mt-4 text-lg leading-relaxed text-white/85">
          Cuéntanos qué hace tu negocio y te enviamos una propuesta clara con precio y fecha de entrega.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href="/#contacto" class="btn bg-sky text-ink shadow-[5px_5px_0_0_var(--color-ink)] hover:-translate-y-0.5 hover:bg-peri">
            Pedir mi propuesta
          </a>
          <a href={waLink(waMessage)} target="_blank" rel="noopener noreferrer" class="btn border-white/40 bg-white/10 text-white hover:bg-white/20">
            <WhatsAppIcon class="h-4 w-4" />
            {site.whatsappLabel}
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(serviceLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
</Base>
