---
import Check from "./Check.astro";
import { usd, webPlans } from "../data/site";
---

<section id="planes" class="scroll-mt-24 py-20 sm:py-24">
  <div class="container-x">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="eyebrow">Planes y precios</span>
      <h2 class="section-title mt-5">Planes claros. Precios sin sorpresas.</h2>
      <p class="mt-4 text-lg leading-relaxed text-ink/65">
        Un pago único por el diseño y desarrollo. Elige mantenimiento solo si lo necesitas.
      </p>
    </div>

    <p class="mt-5 text-center font-display text-xs font-bold uppercase tracking-[0.14em] text-ink/40 md:hidden">
      Desliza para comparar los planes →
    </p>

    <div class="-mx-4 -mb-6 mt-6 overflow-x-auto px-4 pb-6 md:mx-0 md:mb-0 md:mt-12 md:overflow-visible md:px-0 md:pb-0">
      <div class="flex min-w-max snap-x snap-mandatory gap-5 md:mx-auto md:min-w-0 md:max-w-3xl md:snap-none md:grid md:grid-cols-2 md:items-stretch md:gap-6">
      {
        webPlans.map((plan, index) => (
          <article
            class:list={[
              "reveal relative flex h-full w-[280px] snap-start flex-col rounded-[1.75rem] border-2 border-ink p-6 sm:w-[320px] sm:p-7 md:w-auto",
              plan.highlighted
                ? "bg-ink text-cream shadow-pop md:-translate-y-3"
                : "bg-white text-ink shadow-pop-sm transition duration-200 hover:-translate-y-1 hover:shadow-pop",
            ]}
            style={`transition-delay: ${index * 70}ms`}
          >
            {plan.badge && (
              <span class="mb-4 self-center rounded-full border-2 border-ink bg-pink px-3 py-1 font-display text-[0.7rem] font-bold uppercase tracking-wider text-ink md:absolute md:-top-4 md:left-1/2 md:-translate-x-1/2 md:mb-0">
                {plan.badge}
              </span>
            )}

            <h3 class="font-display text-xl font-extrabold tracking-tight">{plan.name}</h3>
            <p class:list={["mt-2 text-sm leading-relaxed", plan.highlighted ? "text-cream/70" : "text-ink/60"]}>
              {plan.tagline}
            </p>

            {plan.price !== null ? (
              <p class="mt-4 flex items-end gap-2">
                <span class="font-display text-3xl font-black tracking-tight">{usd(plan.price)}</span>
                <span class:list={["pb-1 text-xs font-semibold uppercase tracking-wider", plan.highlighted ? "text-cream/60" : "text-ink/65"]}>
                  pago único
                </span>
              </p>
            ) : (
              <p class="mt-4 font-display text-base font-extrabold">Contáctanos para cotizar</p>
            )}

            <div class:list={["my-4 border-t-2", plan.highlighted ? "border-cream/15" : "border-ink/10"]} />

            <ul class="flex flex-col gap-2.5">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-2.5 text-sm font-medium leading-snug">
                  <Check class={`mt-0.5 h-4 w-4 shrink-0 ${plan.highlighted ? "text-sky" : "text-grape"}`} />
                  <span class:list={[plan.highlighted ? "text-cream/85" : "text-ink/75"]}>{feature}</span>
                </li>
              ))}
            </ul>

            <div class="mt-auto pt-6">
              <a
                href="#contacto"
                data-plan={plan.name}
                class:list={[
                  "btn w-full text-sm sm:text-base",
                  plan.highlighted
                    ? "bg-sky text-ink shadow-[5px_5px_0_0_var(--color-sky)] hover:-translate-y-0.5 hover:bg-peri active:translate-y-0 active:shadow-none"
                    : "btn-secondary",
                ]}
              >
                {plan.price !== null ? `Elegir ${plan.name}` : "Contactar para cotizar"}
              </a>
            </div>
          </article>
        ))
      }
      </div>
    </div>

    <div class="reveal mx-auto mt-8 flex w-full max-w-md flex-col items-center justify-between gap-4 rounded-2xl border-2 border-ink bg-white px-6 py-5 shadow-pop-sm md:max-w-3xl md:mt-10 sm:flex-row">
      <p class="text-sm font-medium text-ink/70">
        <span class="font-display font-extrabold text-ink">Todos los planes incluyen</span>
        dominio conectado, SSL, diseño adaptable, SEO básico y capacitación.
      </p>
    </div>
  </div>
</section>
