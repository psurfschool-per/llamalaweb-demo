---
import Check from "./Check.astro";
import { usd, webPlans } from "../data/site";
---

<section id="planes" class="scroll-mt-24 py-20 sm:py-24">
  <div class="container-x">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="eyebrow">Planes y precios</span>
      <h2 class="section-title mt-5">Planes claros. Precios sin sorpresas.</h2>
      <p class="mt-4 text-lg leading-relaxed text-ink/65">
        Un pago único por el diseño y desarrollo. Elige mantenimiento solo si lo necesitas.
      </p>
    </div>

    <!-- Contenedor con scroll horizontal en móvil -->
    <div class="mt-14 overflow-x-auto -mx-4 px-4 lg:mx-0 lg:px-0 lg:overflow-visible">
      <div class="flex gap-5 lg:grid lg:grid-cols-2 lg:items-stretch">
        {
          webPlans.map((plan, index) => (
            <article
              class:list={[
                "reveal relative flex flex-col rounded-[2rem] border-2 border-ink p-5 sm:p-6 w-[82%] sm:w-[85%] lg:w-auto lg:p-7 flex-shrink-0",
                plan.highlighted
                  ? "bg-ink text-cream shadow-pop lg:-translate-y-3"
                  : "bg-white text-ink shadow-pop-sm transition duration-200 hover:-translate-y-1 hover:shadow-pop",
              ]}
              style={`transition-delay: ${index * 70}ms`}
            >
              {plan.badge && (
                <span class="absolute -top-4 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full border-2 border-ink bg-pink px-4 py-1 font-display text-[0.7rem] font-bold uppercase tracking-wider text-ink">
                  {plan.badge}
                </span>
              )}

              <h3 class="font-display text-xl sm:text-2xl font-extrabold tracking-tight">{plan.name}</h3>
              <p class:list={["mt-2 text-xs sm:text-sm leading-relaxed", plan.highlighted ? "text-cream/70" : "text-ink/60"]}>
                {plan.tagline}
              </p>

              {plan.price !== null ? (
                <p class="mt-3 flex items-end gap-2">
                  <span class="font-display text-3xl sm:text-4xl font-black tracking-tight">{usd(plan.price)}</span>
                  <span class:list={["pb-1 text-[0.65rem] sm:text-xs font-semibold uppercase tracking-wider", plan.highlighted ? "text-cream/60" : "text-ink/65"]}>
                    pago único
                  </span>
                </p>
              ) : (
                <p class="mt-3 font-display text-base sm:text-lg font-extrabold">Contáctanos para cotizar</p>
              )}

              <div class:list={["my-4 border-t-2", plan.highlighted ? "border-cream/15" : "border-ink/10"]} />

              <ul class="flex flex-col gap-2">
                {plan.features.map((feature) => (
                  <li class="flex items-start gap-2 text-xs sm:text-sm font-medium leading-snug">
                    <Check class={`mt-0.5 h-3.5 w-3.5 sm:h-4 sm:w-4 ${plan.highlighted ? "text-sky" : "text-grape"}`} />
                    <span class:list={[plan.highlighted ? "text-cream/85" : "text-ink/75"]}>{feature}</span>
                  </li>
                ))}
              </ul>

              <div class="mt-auto pt-5 sm:pt-6">
                <a
                  href="#contacto"
                  data-plan={plan.name}
                  class:list={[
                    "btn w-full text-sm sm:text-base",
                    plan.highlighted
                      ? "bg-sky text-ink shadow-[5px_5px_0_0_var(--color-sky)] hover:-translate-y-0.5 hover:bg-peri active:translate-y-0 active:shadow-none"
                      : "btn-secondary",
                  ]}
                >
                  {plan.price !== null ? `Elegir ${plan.name}` : "Contactar para cotizar"}
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <div class="reveal mt-10 flex flex-col items-center justify-between gap-4 rounded-2xl border-2 border-ink bg-white px-6 py-5 shadow-pop-sm sm:flex-row">
      <p class="text-sm font-medium text-ink/70">
        <span class="font-display font-extrabold text-ink">Todos los planes incluyen</span>
        dominio conectado, SSL, diseño adaptable, SEO básico y capacitación.
      </p>
    </div>
  </div>
</section>
