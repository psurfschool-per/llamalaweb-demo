---
import { portfolio } from "../data/site";

const domainOf = (url: string) => url.replace(/^https?:\/\//, "").replace(/^www\./, "");
const initialsOf = (name: string) =>
  name
    .split(" ")
    .filter((word) => /[a-záéíóúñ]/i.test(word))
    .slice(0, 2)
    .map((word) => word[0]!.toUpperCase())
    .join("");
---

<section id="portafolio" class="scroll-mt-24 pt-20 sm:pt-24">
  <div class="container-x">
    <div class="reveal max-w-2xl">
      <span class="eyebrow">Portafolio</span>
      <h2 class="section-title mt-5">
        Webs que ya están <span class="text-grape">online y trabajando</span>.
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-ink/65">
        Negocios peruanos reales que hoy reciben clientes, reservas y pedidos desde su propia web.
      </p>
    </div>

    <p class="mt-5 text-center font-display text-xs font-bold uppercase tracking-[0.14em] text-ink/40 sm:hidden">
      Desliza para ver más webs →
    </p>

    <div class="-mx-4 -mb-6 mt-6 overflow-x-auto px-4 pb-6 sm:mx-0 sm:mb-0 sm:mt-10 sm:overflow-visible sm:px-0 sm:pb-0">
      <div class="flex min-w-max snap-x snap-mandatory gap-5 sm:mx-auto sm:min-w-0 sm:max-w-4xl sm:snap-none sm:grid sm:grid-cols-2">
      {
        portfolio.map((project, index) => (
          <article
            class="reveal group flex w-[280px] snap-start flex-col overflow-hidden rounded-[1.5rem] border-2 border-ink bg-white shadow-pop-sm transition duration-200 hover:-translate-y-1 hover:shadow-pop sm:w-auto"
            style={`transition-delay: ${index * 70}ms`}
          >
            {/* Barra tipo navegador */}
            <div class="flex items-center gap-2.5 border-b-2 border-ink bg-cream px-3.5 py-2">
              <span class="flex gap-1" aria-hidden="true">
                <span class="h-2.5 w-2.5 rounded-full border-2 border-ink bg-pink" />
                <span class="h-2.5 w-2.5 rounded-full border-2 border-ink bg-sky" />
                <span class="h-2.5 w-2.5 rounded-full border-2 border-ink bg-peri" />
              </span>
              <span class="truncate font-mono text-[0.68rem] font-semibold text-ink/60">
                {domainOf(project.url)}
              </span>
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Visitar ${project.name}`}
                class="ml-auto inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full border-2 border-ink bg-white text-ink transition hover:bg-grape-soft"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-3.5 w-3.5">
                  <path d="M7 17 17 7M9 7h8v8" />
                </svg>
              </a>
            </div>

            {/* Captura del sitio */}
            <a
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
              class="pf-shot block aspect-[2/1] overflow-hidden"
              aria-label={`Visitar ${project.name}`}
              tabindex="-1"
            >
              <span class:list={["pf-ph", project.tile]} aria-hidden="true">
                <span class="font-display text-4xl font-black tracking-tight text-ink/70">
                  {initialsOf(project.name)}
                </span>
                <span class="font-display text-[0.65rem] font-bold uppercase tracking-[0.14em] text-ink/45">
                  {project.name}
                </span>
              </span>
              <img
                class="pf-img"
                src={project.image}
                alt={`Captura del sitio web de ${project.name}`}
                width="1600"
                height="800"
                loading="lazy"
                decoding="async"
              />
            </a>

            {/* Información */}
            <div class="flex flex-1 flex-col p-5">
              <div class="flex items-center justify-between gap-3">
                <h3 class="font-display text-lg font-extrabold tracking-tight">
                  <a href={project.url} target="_blank" rel="noopener noreferrer" class="hover:underline">
                    {project.name}
                  </a>
                </h3>
                <span
                  class:list={[
                    "shrink-0 rounded-full border-2 border-ink px-2 py-0.5 font-display text-[0.6rem] font-bold uppercase tracking-wide",
                    project.tile,
                  ]}
                >
                  {project.category}
                </span>
              </div>

              <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-ink/65">{project.description}</p>

              <ul class="mt-3 flex flex-wrap gap-1.5">
                {project.tags.map((tag) => (
                  <li class="rounded-md border-2 border-ink/15 bg-cream px-2 py-0.5 text-[0.65rem] font-semibold text-ink/60">
                    {tag}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
      </div>
    </div>

    <p class="reveal mt-8 text-center text-sm font-medium text-ink/60">
      ¿Quieres una web así para tu negocio?
      <a href="#contacto" class="link-underline font-bold text-ink">Conversemos</a>
    </p>
  </div>
</section>

<style>
  .pf-shot {
    position: relative;
    background: var(--color-cream);
  }

  .pf-ph {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
  }

  .pf-img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .group:hover .pf-img {
    transform: scale(1.03);
  }

  /* Si aún no hay captura, se muestra el placeholder con las iniciales */
  .pf-shot.is-missing .pf-img {
    display: none;
  }
</style>

<script>
  document.querySelectorAll<HTMLImageElement>(".pf-img").forEach((img) => {
    const markMissing = () => img.closest(".pf-shot")?.classList.add("is-missing");

    if (img.complete && img.naturalWidth === 0) markMissing();
    else img.addEventListener("error", markMissing, { once: true });
  });
</script>
