---
type IconName = "layout" | "cart" | "search" | "shield";

type Props = {
  name: IconName;
  class?: string;
};

const { name, class: className = "h-6 w-6" } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class:list={[className]}
>
  {
    name === "layout" && (
      <>
        <rect x="3" y="4" width="18" height="16" rx="2.5" />
        <path d="M3 9.5h18M9.5 9.5V20" />
      </>
    )
  }
  {
    name === "cart" && (
      <>
        <circle cx="9" cy="20" r="1.4" />
        <circle cx="18" cy="20" r="1.4" />
        <path d="M2.5 3.5h2.8l2.3 11a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.6L21 7H6" />
      </>
    )
  }
  {
    name === "search" && (
      <>
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-3.6-3.6" />
      </>
    )
  }
  {
    name === "shield" && (
      <>
        <path d="M12 3l7 3v5.5c0 4.1-3 7.4-7 8.5-4-1.1-7-4.4-7-8.5V6l7-3z" />
        <path d="m9 12 2 2 4-4" />
      </>
    )
  }
</svg>
