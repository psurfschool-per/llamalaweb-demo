---
import WhatsAppIcon from "./WhatsAppIcon.astro";
import { site, waLink, waMessage } from "../data/site";

const href = waLink(waMessage);
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Escríbenos por WhatsApp al ${site.whatsappLabel}`}
  class="float-slow fixed bottom-5 right-5 z-50 flex h-14 w-14 items-center justify-center rounded-full border-2 border-ink bg-grape text-white shadow-pop-sm transition-colors duration-150 hover:bg-grape-dark hover:shadow-pop focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-grape/30 sm:bottom-7 sm:right-7 sm:h-16 sm:w-16"
  style="margin-bottom: env(safe-area-inset-bottom); margin-right: env(safe-area-inset-right);"
>
  <WhatsAppIcon class="h-7 w-7 sm:h-8 sm:w-8" />
</a>
