---
import WhatsAppIcon from "./WhatsAppIcon.astro";
import { site, waLink, waMessage } from "../data/site";

const href = waLink(waMessage);
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Escríbenos por WhatsApp al ${site.whatsappLabel}`}
  class="group fixed bottom-5 right-5 z-50 inline-flex items-center gap-3 rounded-full border-2 border-ink bg-grape text-white shadow-pop-sm transition-all duration-150 hover:-translate-y-0.5 hover:bg-grape-dark hover:shadow-pop active:translate-x-[2px] active:translate-y-[2px] active:shadow-none focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-grape/30 sm:bottom-7 sm:right-7"
  style="margin-bottom: env(safe-area-inset-bottom); margin-right: env(safe-area-inset-right);"
>
  <span
    class="hidden rounded-full bg-white/15 px-4 py-2 font-display text-sm font-bold sm:inline-flex"
  >
    WhatsApp
  </span>
  <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white/15 transition-colors group-hover:bg-white/25 sm:h-14 sm:w-14">
    <WhatsAppIcon class="h-6 w-6 sm:h-7 sm:w-7" />
  </span>
</a>
