---
import { faqs } from "../data/site";
---

<section id="preguntas" class="scroll-mt-24 py-20 sm:py-24">
  <div class="container-x grid gap-12 lg:grid-cols-[0.82fr_1.18fr] lg:gap-16">
    <div class="reveal lg:sticky lg:top-28 lg:self-start">
      <span class="eyebrow">Preguntas frecuentes</span>
      <h2 class="section-title mt-5">Resolvemos tus dudas antes de empezar.</h2>
      <p class="mt-4 max-w-md text-lg leading-relaxed text-ink/65">
        Si tienes una pregunta que no aparece aquí, escríbenos. Respondemos en menos de 24 horas hábiles.
      </p>
      <a href="#contacto" class="btn btn-primary mt-7">
        Hacer mi consulta
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-5 w-5">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
    </div>

    <div class="reveal divide-y-2 divide-ink/10 overflow-hidden rounded-[1.75rem] border-2 border-ink bg-white shadow-pop-sm">
      {
        faqs.map((faq) => (
          <details class="group px-6 py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-base font-bold leading-snug marker:hidden focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-grape/25 sm:text-lg">
              {faq.q}
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border-2 border-ink bg-grape-soft transition-transform duration-200 group-open:rotate-45">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true" class="h-4 w-4">
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </span>
            </summary>
            <p class="mt-3 pr-10 text-sm leading-relaxed text-ink/65 sm:text-base">{faq.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
