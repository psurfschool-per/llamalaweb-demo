---
type Props = {
  class?: string;
};

const { class: className = "" } = Astro.props;
---

<svg
  viewBox="0 0 20 20"
  fill="none"
  aria-hidden="true"
  class:list={["h-5 w-5 shrink-0", className]}
>
  <path
    d="M4 10.5l4 4L16 5.5"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>
