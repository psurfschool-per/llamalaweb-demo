---
import Logo from "./Logo.astro";
import { site } from "../data/site";

const year = new Date().getFullYear();

const links = [
  { href: "#servicios", label: "Servicios" },
  { href: "#planes", label: "Planes" },
  { href: "#mantenimiento", label: "Mantenimiento" },
  { href: "#preguntas", label: "Preguntas frecuentes" },
  { href: "#contacto", label: "Contacto" },
];
---

<footer class="bg-ink pb-8 pt-16 text-cream">
  <div class="container-x">
    <div class="grid gap-10 border-b-2 border-cream/10 pb-12 sm:grid-cols-2 lg:grid-cols-[1.4fr_0.8fr_0.8fr]">
      <div>
        <Logo class="text-cream" imgClass="h-12 w-auto" />
        <p class="mt-4 max-w-sm leading-relaxed text-cream/55">
          Diseñamos, lanzamos y mantenemos webs para negocios que quieren crecer. Sin tecnicismos, sin
          permanencia y con soporte humano.
        </p>
        <a
          href={`mailto:${site.email}`}
          class="mt-5 inline-flex items-center gap-2 font-display font-bold text-sky underline decoration-2 underline-offset-4 hover:decoration-4"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-4 w-4">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3 7 9 6 9-6" />
          </svg>
          {site.email}
        </a>
      </div>

      <div>
        <p class="font-display text-xs font-bold uppercase tracking-[0.16em] text-cream/55">Explorar</p>
        <ul class="mt-4 flex flex-col gap-2.5">
          {
            links.map((link) => (
              <li>
                <a href={link.href} class="text-sm font-medium text-cream/65 transition-colors hover:text-white">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="font-display text-xs font-bold uppercase tracking-[0.16em] text-cream/55">Empezar</p>
        <ul class="mt-4 flex flex-col gap-2.5 text-sm font-medium text-cream/65">
          <li>Desde S/500</li>
          <li>Entrega en 10-14 días</li>
          <li>Hosting y seguimiento desde $20/mes</li>
          <li>Sin contratos de permanencia</li>
        </ul>
        <a href="#contacto" class="btn btn-sm mt-5 border-cream/30 bg-cream text-ink hover:bg-sky">
          Quiero mi web
        </a>
      </div>
    </div>

    <div class="flex flex-col items-center justify-between gap-3 pt-6 text-xs text-cream/55 sm:flex-row">
      <p>© {year} llamalaweb.com — Todos los derechos reservados.</p>
      <p>Hecho con cariño para negocios que crecen.</p>
    </div>
  </div>
</footer>
