---
import Check from "./Check.astro";
import { maintenancePlans, usd } from "../data/site";
---

<section id="mantenimiento" class="relative scroll-mt-24 overflow-hidden border-y-2 border-ink bg-ink py-20 text-cream sm:py-24">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="absolute -right-24 top-0 h-80 w-80 rounded-full bg-grape/30 blur-3xl"></div>
    <div class="absolute -left-20 bottom-0 h-72 w-72 rounded-full bg-sky/10 blur-3xl"></div>
  </div>

  <div class="container-x relative">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="eyebrow border-cream/20 bg-cream/10 text-cream">Mantenimiento</span>
      <h2 class="section-title mt-5">Tu web, siempre al día. Tú, siempre tranquilo.</h2>
      <p class="mt-4 text-lg leading-relaxed text-cream/65">
        Hosting, seguridad, backups y mejoras continuas desde {usd(maintenancePlans[0].price)}/mes.
        Sin contratos de permanencia.
      </p>
    </div>

    <div class="mt-14 grid items-stretch gap-5 lg:grid-cols-3">
      {
        maintenancePlans.map((plan, index) => (
          <article
            class:list={[
              "reveal relative flex h-full flex-col rounded-[1.75rem] border-2 border-ink p-7",
              plan.highlighted
                ? "bg-sky text-ink shadow-[8px_8px_0_0_var(--color-grape)]"
                : "bg-white text-ink shadow-[6px_6px_0_0_rgba(251,247,239,0.35)]",
            ]}
            style={`transition-delay: ${index * 70}ms`}
          >
            {plan.badge && (
              <span class="absolute -top-3.5 right-5 rounded-full border-2 border-ink bg-grape px-3 py-1 font-display text-[0.65rem] font-bold uppercase tracking-wider text-white">
                {plan.badge}
              </span>
            )}

            <div class="flex items-baseline justify-between gap-2">
              <h3 class="font-display text-xl font-extrabold tracking-tight">{plan.name}</h3>
            </div>
            <p class="mt-1.5 text-sm leading-relaxed text-ink/70">{plan.summary}</p>

            <p class="mt-5 flex items-end gap-1.5">
              <span class="font-display text-4xl font-black tracking-tight">{usd(plan.price)}</span>
              <span class="pb-1 text-sm font-semibold text-ink/70">/mes</span>
            </p>

            <div class="my-5 border-t-2 border-ink/10" />

            <ul class="flex flex-col gap-2.5">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-2.5 text-sm font-medium leading-snug text-ink/75">
                  <Check class="mt-0.5 h-4 w-4 text-grape" />
                  {feature}
                </li>
              ))}
            </ul>

            <div class="mt-auto pt-7">
              <a
                href="#contacto"
                data-plan={`Mantenimiento ${plan.name}`}
                class:list={["btn w-full", plan.highlighted ? "btn-primary" : "btn-secondary"]}
              >
                Agregar {plan.name}
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <p class="reveal mt-10 text-center text-sm font-medium text-cream/60">
      ¿Ya tienes una web? También puedes contratar solo el mantenimiento.
      <a href="#contacto" class="font-bold text-sky underline decoration-2 underline-offset-4 hover:decoration-4">Pídelo aquí</a>.
    </p>
  </div>
</section>

