---
import Check from "./Check.astro";
import { maintenancePlans, usd } from "../data/site";
---

<section id="mantenimiento" class="relative scroll-mt-24 overflow-hidden border-y-2 border-ink bg-ink py-20 text-cream sm:py-24">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="absolute -right-24 top-0 h-80 w-80 rounded-full bg-grape/30 blur-3xl"></div>
    <div class="absolute -left-20 bottom-0 h-72 w-72 rounded-full bg-sky/10 blur-3xl"></div>
  </div>

  <div class="container-x relative">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="eyebrow border-cream/20 bg-cream/10 text-cream">Mantenimiento</span>
      <h2 class="section-title mt-5">Tu web, siempre al día. Tú, siempre tranquilo.</h2>
      <p class="mt-4 text-lg leading-relaxed text-cream/65">
        Hosting, seguridad, backups y mejoras continuas desde {usd(maintenancePlans[0].price)}/mes.
        Sin contratos de permanencia.
      </p>
    </div>

    <!-- Scroll horizontal en móvil / tablet, grid contenido en escritorio -->
    <div class="-mx-4 -mb-8 -mt-5 mt-12 overflow-x-auto px-4 pb-8 pt-5 sm:mx-0 sm:px-0 lg:overflow-visible">
      <div class="flex min-w-max snap-x snap-mandatory gap-5 lg:mx-auto lg:min-w-0 lg:max-w-4xl lg:snap-none lg:grid lg:grid-cols-3 lg:items-stretch lg:gap-6">
        {
          maintenancePlans.map((plan, index) => (
            <article
              class:list={[
                "reveal relative flex w-[260px] snap-start flex-col rounded-[1.75rem] border-2 border-ink p-6 sm:w-[300px] lg:w-auto",
                plan.highlighted
                  ? "bg-sky text-ink shadow-[8px_8px_0_0_var(--color-grape)]"
                  : "bg-white text-ink shadow-[6px_6px_0_0_rgba(251,247,239,0.35)]",
              ]}
              style={`transition-delay: ${index * 70}ms`}
            >
              {plan.badge && (
                <span class="absolute -top-3.5 right-5 rounded-full border-2 border-ink bg-grape px-3 py-1 font-display text-[0.65rem] font-bold uppercase tracking-wider text-white">
                  {plan.badge}
                </span>
              )}

              <h3 class="font-display text-lg font-extrabold tracking-tight">{plan.name}</h3>
              <p class="mt-1.5 text-xs leading-relaxed text-ink/70">{plan.summary}</p>

              <p class="mt-4 flex items-end gap-1.5">
                <span class="font-display text-3xl font-black tracking-tight">{usd(plan.price)}</span>
                <span class="pb-1 text-xs font-semibold text-ink/70">/mes</span>
              </p>

              <div class="my-4 border-t-2 border-ink/10" />

              <ul class="flex flex-col gap-2">
                {plan.features.map((feature) => (
                  <li class="flex items-start gap-2 text-xs font-medium leading-snug text-ink/75">
                    <Check class="mt-0.5 h-3.5 w-3.5 shrink-0 text-grape" />
                    {feature}
                  </li>
                ))}
              </ul>

              <div class="mt-auto pt-6">
                <a
                  href="#contacto"
                  data-plan={`Mantenimiento ${plan.name}`}
                  class:list={["btn btn-sm w-full", plan.highlighted ? "btn-primary" : "btn-secondary"]}
                >
                  Agregar {plan.name}
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <p class="reveal mt-6 text-center text-sm font-medium text-cream/60 lg:mt-10">
      <span class="mb-1 block text-xs uppercase tracking-[0.14em] text-cream/40 lg:hidden">Desliza para ver los planes →</span>
      ¿Ya tienes una web? También puedes contratar solo el mantenimiento.
      <a href="#contacto" class="font-bold text-sky underline decoration-2 underline-offset-4 hover:decoration-4">Pídelo aquí</a>.
    </p>
  </div>
</section>
