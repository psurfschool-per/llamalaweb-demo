---
import Icon from "./Icon.astro";

const services = [
  {
    icon: "layout" as const,
    title: "Diseño y desarrollo web",
    text: "Sitios a medida, rápidos y 100% adaptable que reflejan tu marca y guían al cliente hacia el contacto.",
    tile: "bg-sky",
  },
  {
    icon: "cart" as const,
    title: "Tiendas y reservas",
    text: "Catálogos, e-commerce y agendamiento con pagos integrados para vender sin fricción, a cualquier hora.",
    tile: "bg-pink",
  },
  {
    icon: "search" as const,
    title: "SEO y presencia local",
    text: "Estructura técnica, Google Maps y analítica para que te encuentren justo cuando están buscando lo que ofreces.",
    tile: "bg-peri",
  },
  {
    icon: "shield" as const,
    title: "Mantenimiento y soporte",
    text: "Actualizaciones, backups, seguridad y mejoras continuas para que tu web nunca se quede atrás.",
    tile: "bg-grape-soft",
  },
];
---

<section id="servicios" class="scroll-mt-24 py-20 sm:py-24">
  <div class="container-x">
    <div class="reveal max-w-2xl">
      <span class="eyebrow">Servicios</span>
      <h2 class="section-title mt-5">
        Todo lo que tu negocio necesita para <span class="text-grape">destacar online</span>.
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-ink/65">
        No vendemos plantillas genéricas: armamos la web que tu negocio necesita, con lo justo y bien hecho.
      </p>
    </div>

    <div class="mt-12 -mx-4 overflow-x-auto px-4 sm:mx-0 sm:px-0">
      <div class="flex gap-5 sm:grid sm:grid-cols-2 min-w-max sm:min-w-0">
      {
        services.map((service, index) => (
          <article
            class="reveal group relative flex flex-col rounded-[1.75rem] border-2 border-ink bg-white p-7 shadow-pop-sm transition duration-200 hover:-translate-y-1 hover:shadow-pop w-[280px] sm:w-auto"
            style={`transition-delay: ${index * 60}ms`}
          >
            <div class:list={["flex h-14 w-14 items-center justify-center rounded-2xl border-2 border-ink", service.tile]}>
              <Icon name={service.icon} class="h-7 w-7" />
            </div>
            <h3 class="mt-6 font-display text-2xl font-extrabold tracking-tight">{service.title}</h3>
            <p class="mt-3 leading-relaxed text-ink/65">{service.text}</p>
            <a
              href="#contacto"
              class="mt-6 inline-flex items-center gap-1.5 font-display text-sm font-bold text-grape hover:underline"
            >
              Me interesa
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-4 w-4 transition-transform group-hover:translate-x-1">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          </article>
        ))
      }
      </div>
    </div>
  </div>
</section>
