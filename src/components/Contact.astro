---
import Check from "./Check.astro";
import { maintenancePlans, site, webPlans } from "../data/site";

const planOptions = [
  ...webPlans.map((plan) => plan.name),
  ...maintenancePlans.map((plan) => `Mantenimiento ${plan.name}`),
];
---

<section id="contacto" class="relative scroll-mt-24 overflow-hidden border-y-2 border-ink bg-grape py-20 text-white sm:py-24">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="absolute -right-20 -top-24 h-96 w-96 rounded-full border-2 border-white/10 bg-grape-dark/40"></div>
    <div class="absolute -bottom-32 -left-16 h-80 w-80 rounded-full bg-pink/25 blur-3xl"></div>
    <svg class="absolute right-[8%] top-16 hidden h-12 w-12 text-sky lg:block" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 2l2.2 6.3L21 10l-6.8 1.7L12 18l-2.2-6.3L3 10l6.8-1.7L12 2z"></path>
    </svg>
  </div>

  <div class="container-x relative grid gap-12 lg:grid-cols-[0.92fr_1.08fr] lg:items-start lg:gap-16">
    <div class="reveal">
      <span class="eyebrow border-white/25 bg-white/10 text-white">Empecemos</span>
      <h2 class="font-display text-3xl font-extrabold leading-[1.08] tracking-tight sm:text-4xl lg:text-5xl">
        Cuéntanos qué necesitas y armamos tu web.
      </h2>
      <p class="mt-5 max-w-lg text-lg leading-relaxed text-white/90">
        Completa el formulario o escríbenos directo. Te respondemos con una propuesta clara, sin
        compromiso y sin letra chica.
      </p>

      <ul class="mt-7 flex flex-col gap-3">
        {
          [
            "Respondemos en menos de 24 hr hábiles",
            "Primera conversación sin costo",
            "Trabajamos 100% en remoto",
          ].map((item) => (
            <li class="flex items-center gap-3 font-medium text-white/85">
              <span class="flex h-7 w-7 items-center justify-center rounded-full bg-sky text-ink">
                <Check class="h-4 w-4" />
              </span>
              {item}
            </li>
          ))
        }
      </ul>

      <div class="mt-10 rounded-2xl border-2 border-white/20 bg-white/10 p-5">
        <p class="font-display text-xs font-bold uppercase tracking-wider text-white">Escríbenos directo</p>
        <a
          href={`mailto:${site.email}`}
          class="mt-1 inline-block font-display text-xl font-extrabold text-white underline decoration-sky decoration-2 underline-offset-4 hover:decoration-4 sm:text-2xl"
        >
          {site.email}
        </a>
      </div>
    </div>

    <div class="reveal">
      <form
        id="contacto-form"
        action={`mailto:${site.email}`}
        method="post"
        data-email={site.email}
        class="rounded-[1.75rem] border-2 border-ink bg-cream p-6 text-ink shadow-pop-lg sm:p-8"
      >
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="flex flex-col gap-1.5">
            <label for="nombre" class="font-display text-sm font-bold">Nombre *</label>
            <input id="nombre" name="nombre" type="text" required autocomplete="name" placeholder="Tu nombre" class="field" />
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="email" class="font-display text-sm font-bold">Email *</label>
            <input id="email" name="email" type="email" required autocomplete="email" placeholder="tu@email.com" class="field" />
          </div>
        </div>

        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <div class="flex flex-col gap-1.5">
            <label for="negocio" class="font-display text-sm font-bold">Negocio o proyecto</label>
            <input id="negocio" name="negocio" type="text" autocomplete="organization" placeholder="¿Cómo se llama?" class="field" />
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="plan" class="font-display text-sm font-bold">Me interesa</label>
            <select id="plan" name="plan" class="field">
              <option value="">Aún no lo sé</option>
              {planOptions.map((option) => <option value={option}>{option}</option>)}
            </select>
          </div>
        </div>

        <div class="mt-4 flex flex-col gap-1.5">
          <label for="mensaje" class="font-display text-sm font-bold">Cuéntanos un poco más *</label>
          <textarea
            id="mensaje"
            name="mensaje"
            rows="4"
            required
            placeholder="¿A qué se dedica tu negocio? ¿Qué necesitas lograr con la web?"
            class="field resize-y"
          ></textarea>
        </div>

        <button type="submit" class="btn btn-primary mt-6 w-full">
          Enviar solicitud
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-5 w-5">
            <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" />
          </svg>
        </button>

        <p class="mt-3 text-center text-xs leading-relaxed text-ink/65">
          Al enviar se abrirá tu aplicación de correo con el mensaje listo. También puedes escribirnos a
          <a href={`mailto:${site.email}`} class="font-semibold text-ink/70 underline">{site.email}</a>.
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>("#contacto-form");
  const planSelect = document.querySelector<HTMLSelectElement>("#plan");

  document.querySelectorAll<HTMLAnchorElement>("a[data-plan]").forEach((link) => {
    link.addEventListener("click", () => {
      if (planSelect && link.dataset.plan) planSelect.value = link.dataset.plan;
    });
  });

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    const data = new FormData(form);
    const email = form.dataset.email ?? "hola@llamalaweb.com";
    const plan = String(data.get("plan") || "Plan por definir");
    const subject = `Nueva solicitud web — ${plan}`;

    const body = [
      `Nombre: ${data.get("nombre") ?? ""}`,
      `Email: ${data.get("email") ?? ""}`,
      `Negocio: ${data.get("negocio") || "-"}`,
      `Plan de interés: ${plan}`,
      "",
      "Mensaje:",
      String(data.get("mensaje") ?? ""),
    ].join("\n");

    window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>

